# Copy to .env and fill in. Never commit .env.

# Database. Under docker compose the app overrides this to point at the "db" service.
DATABASE_URL=postgresql://rfp:rfp@localhost:5432/rfp
# Database used by tests marked "db"; use a throwaway database, its tables may be dropped.
TEST_DATABASE_URL=postgresql://rfp:rfp@localhost:5433/rfp_test

# OpenAI-compatible LLM and embeddings endpoint. Leave the key empty to run without LLM calls.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Local mode (no external API): start with `docker compose --profile local up -d`, pull the models
# (`docker compose exec ollama ollama pull qwen2.5:7b` and `... pull bge-m3`), then replace the OpenAI block above with:
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:7b        # answers, question translation and layout map (QUERY_MODEL, LAYOUT_MODEL default to it)
#   JUDGE_MODEL=qwen2.5:7b      # only for the evaluation run
#   EMBEDDING_MODEL=bge-m3
#   EMBEDDING_DIM=1024
# bge-m3 gives 1024-dimensional vectors, the OpenAI model 1536. The vector column size follows EMBEDDING_DIM, so
# changing it needs a separate empty database (new volume or DATABASE_URL), then re-index the knowledge base.

# Knowledge base directory and background-job polling interval (seconds, 1-300).
KB_DIR=data/kb
POLL_INTERVAL_S=60

# Retrieval and answering.
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.5
ANSWER_PROMPT_PATH=prompts/answer.md
JUDGE_PROMPT_PATH=prompts/judge.md

# Where answers go in an uploaded file: LAYOUT_MODE=llm asks the model for a layout map and checks it in
# code (header rules are the fallback); LAYOUT_MODE=rules uses header rules only. LAYOUT_MODEL defaults to LLM_MODEL.
LAYOUT_MODE=llm
LAYOUT_MODEL=
LAYOUT_PROMPT_PATH=prompts/layout.md

# Web access. SECRET_KEY signs session cookies (generate: python -c "import secrets; print(secrets.token_urlsafe(32))").
# The first administrator is created at startup from ADMIN_USERNAME/ADMIN_PASSWORD when no users exist yet.
SECRET_KEY=
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Poll KB_DIR in the background (false in tests), questionnaire workers, upload size limit in MB.
WATCH_KB=true
JOB_WORKERS=2
MAX_UPLOAD_MB=25
