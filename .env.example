# Copy to .env and fill in. Never commit .env.

# Database. Under docker compose the app overrides this to point at the "db" service.
DATABASE_URL=postgresql://rfp:rfp@localhost:5432/rfp
# Database used by tests marked "db"; use a throwaway database, its tables may be dropped.
TEST_DATABASE_URL=postgresql://rfp:rfp@localhost:5433/rfp_test

# OpenAI-compatible LLM and embeddings endpoint. Leave the key empty to run without LLM calls.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Knowledge base directory and background-job polling interval (seconds, 1-300).
KB_DIR=data/kb
POLL_INTERVAL_S=60

# Retrieval and answering.
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.5
ANSWER_PROMPT_PATH=prompts/answer.md
JUDGE_PROMPT_PATH=prompts/judge.md

# Web access. SECRET_KEY signs session cookies (generate: python -c "import secrets; print(secrets.token_urlsafe(32))").
# The first administrator is created at startup from ADMIN_USERNAME/ADMIN_PASSWORD when no users exist yet.
SECRET_KEY=
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Poll KB_DIR in the background (false in tests), questionnaire workers, upload size limit in MB.
WATCH_KB=true
JOB_WORKERS=2
MAX_UPLOAD_MB=25
